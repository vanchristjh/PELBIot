{
  "name": "pelbiot-backend",
  "version": "2.0.0",
  "description": "PELBIOT Real-Time Monitoring System Backend",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node utils/seedData.js",
    "seed:users": "node utils/seedUsers.js",
    "test": "jest --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "format": "prettier --check \"**/*.js\"",
    "format:fix": "prettier --write \"**/*.js\""
  },
  "keywords": [
    "pelbiot",
    "real-time",
    "monitoring"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "dependencies": {
    "@sentry/node": "11.4.0",
    "axios": "1.20.0",
    "bcryptjs": "3.0.3",
    "chalk": "5.6.2",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "exceljs": "^4.4.0",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "express-validator": "7.3.2",
    "validator": "13.15.35",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "jsonwebtoken": "9.0.3",
    "mqtt": "5.16.0",
    "mqtt-pattern": "2.1.1",
    "mysql2": "3.24.5",
    "nodemailer": "^10.0.13",
    "pdfkit": "^0.17.2",
    "redis": "5.12.1",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "6.3.0",
    "swagger-ui-express": "5.0.1",
    "xss": "1.0.15"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "braces": "^3.0.3",
    "chokidar": "^4.0.3"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "eslint": "9.39.5",
    "jest": "30.5.2",
    "nodemon": "3.1.10",
    "prettier": "3.9.9",
    "supertest": "7.3.1"
  }
}
