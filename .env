# Application Environment - LOCAL DEMO (docker-compose)
NODE_ENV=production
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database Configuration (must match docker-compose defaults)
DB_USER=pelbiot
DB_PASSWORD=pelbiot123
DB_NAME=pelbiot
DB_PORT=3307
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=pelbiot
MYSQL_USER=pelbiot
MYSQL_PASSWORD=pelbiot123
DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_NAME=pelbiot
DATABASE_USER=pelbiot
DATABASE_PASSWORD=pelbiot123

# Redis
REDIS_PASSWORD=redis123
REDIS_PORT=6379

# Frontend Configuration
REACT_APP_API_URL=http://localhost/api
REACT_APP_SOCKET_URL=http://localhost

# Security
JWT_SECRET=demo-secret-key-local-only-change-in-prod-12345
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=demo-refresh-secret-local-12345
JWT_REFRESH_EXPIRE=30d
ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:80

# Email (optional, dummy for local)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=dummy@pelbiot.local
EMAIL_PASSWORD=dummy
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=dummy@pelbiot.local
SMTP_PASSWORD=dummy

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
